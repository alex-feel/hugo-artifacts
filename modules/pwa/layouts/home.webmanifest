{{/*
  Templated Web App Manifest output.

  Renders when the consumer site adds 'webappmanifest' to outputs.home.
  Output URL: /manifest.webmanifest
  Content-Type: application/manifest+json (Hugo built-in default for the .webmanifest suffix)

  Reads defaults from hugo.Data.pwa.defaults.manifest, with site.Params.pwa.manifest overrides.

  Consumed by Lighthouse "Installable" check (manifest portion); the SW prerequisite is supplied
  by a separate service-worker registration partial.

  scope, start_url, and id go through pwa/lib/absolute-url.html, so each carries the baseURL's
  path. The shipped defaults are "/", which a browser resolves against the ORIGIN, not against the
  manifest's directory: on a site at https://example.org/docs/ an unnormalized scope points at the
  whole domain, start_url launches the installed app outside the site, and every derived icon src
  404s. icons[] is normalized inside pwa/functions/icon-list.html.

  id deserves its own note, because the W3C manifest spec makes it the app's stable identity and
  changing it makes the browser treat the manifest as a DIFFERENT app. It is normalized anyway,
  for two reasons. First, an id of "/" resolves to the origin, so two PWAs installed from two
  subpaths of one host claim the SAME identity and collide; carrying the site path is what makes
  the identity actually identify this app. Second, there is no working subpath install to orphan:
  before this normalization every derived icon 404ed on such a site, which is disqualifying for
  installability, so the change cannot break an install that a subpath consumer already had. A
  consumer who must nonetheless keep a specific historical identity pins it by writing a FULL URL
  (params.pwa.manifest.id = "https://example.org/docs/"), which this module passes through
  untouched; a path written with a leading slash is always normalized.
*/}}
{{- $defaults := hugo.Data.pwa.defaults.manifest -}}
{{- $params := site.Params.pwa.manifest | default dict -}}
{{- $cfg := merge $defaults $params -}}

{{- $name := $cfg.name | default site.Title -}}
{{- $shortName := $cfg.short_name | default $name -}}
{{- $description := $cfg.description | default site.Params.description -}}
{{- $themeColor := $cfg.theme_color -}}
{{- $bgColor := $cfg.background_color -}}
{{- $scope := partial "pwa/lib/absolute-url.html" (dict
    "value" $cfg.scope
    "key" "params.pwa.manifest.scope") -}}
{{- $startUrl := partial "pwa/lib/absolute-url.html" (dict
    "value" $cfg.start_url
    "key" "params.pwa.manifest.start_url") -}}
{{- $id := partial "pwa/lib/absolute-url.html" (dict
    "value" $cfg.id
    "key" "params.pwa.manifest.id") -}}
{{- $display := $cfg.display -}}
{{- $displayOverride := $cfg.display_override -}}
{{- $lang := $cfg.lang | default site.Language.Name -}}
{{- $dir := $cfg.dir -}}
{{- $categories := $cfg.categories -}}

{{- $icons := partial "pwa/functions/icon-list.html" . -}}

{{/* The members are emitted one at a time, in a chosen order, because the
     order is load-bearing and a Go map cannot carry one: jsonify serializes
     map keys ALPHABETICALLY, which put `background_color` first and pushed
     `name`, `id`, `short_name`, `scope` and `start_url` behind the `icons`
     array. That array is consumer-supplied and unbounded -- a generated
     favicon set runs to ten or more entries at five lines each -- so on a
     real site the members that say WHAT THE APP IS sit seventy lines into a
     document whose first screen is icon paths. Anything that samples this
     file from the front reads none of them.

     So: identity, then localization, then navigation, then presentation,
     with the unbounded array LAST. Nothing that parses a manifest can
     observe the difference -- JSON member order carries no semantics -- and
     the only readers affected are the ones that never reach the end.

     Every VALUE goes through jsonify, so escaping and the nested indentation
     of the arrays stay the encoder's job (`prefix` is what indents those to
     their parent's level). HTML escaping stays ON, matching what this
     document has always emitted.

     An OPTIONAL member is omitted entirely rather than emitted empty. The
     manifest specification types each of these, and a member present with a
     null or empty value is not a neutral no-op: a validator rejects it and a
     processor discards it, so the only thing it can do is cost the consumer
     a lint failure they did not cause. */}}
{{- $opts := dict "indent" "  " "prefix" "  " -}}
{{- $members := slice -}}
{{- $member := "" -}}

{{- range $pair := slice
    (slice "name" $name)
    (slice "short_name" $shortName)
    (slice "id" $id)
    (slice "description" $description)
    (slice "lang" $lang)
    (slice "dir" $dir)
    (slice "start_url" $startUrl)
    (slice "scope" $scope)
    (slice "display" $display)
    (slice "display_override" $displayOverride)
    (slice "theme_color" $themeColor)
    (slice "background_color" $bgColor)
-}}
  {{- with (index $pair 1) -}}
    {{- $member = printf "  %s: %s" (jsonify $opts (index $pair 0)) (jsonify $opts .) -}}
    {{- $members = $members | append $member -}}
  {{- end -}}
{{- end -}}

{{/* categories is typed as a SEQUENCE of strings. `len` accepts a string in
     Hugo and returns its rune count, so a scalar written for this key --
     `categories = "news"` rather than `["news"]` -- passed a length-only
     gate and published a JSON string where an array belongs, silently. Every
     other mis-shaped input in this module warns exactly once; this one now
     does too. */}}
{{- if reflect.IsSlice $categories -}}
  {{- with $categories -}}
    {{- $members = $members | append (printf "  %s: %s" (jsonify $opts "categories") (jsonify $opts .)) -}}
  {{- end -}}
{{- else if $categories -}}
  {{- $warnKey := "pwa:warn:manifest-categories-shape" -}}
  {{- if not (hugo.Store.Get $warnKey) -}}
    {{- hugo.Store.Set $warnKey true -}}
    {{- warnf "modules/pwa: ignoring params.pwa.manifest.categories -- it expects a list of category strings (e.g. [\"news\", \"weather\"]), but a single value arrived, and the manifest specification types this member as a list. No categories are emitted." -}}
  {{- end -}}
{{- end -}}

{{- with $icons -}}
  {{- $members = $members | append (printf "  %s: %s" (jsonify $opts "icons") (jsonify $opts .)) -}}
{{- end -}}

{{- printf "{\n%s\n}" (delimit $members ",\n") | safeJS -}}
