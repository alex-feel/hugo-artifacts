{{- /*
  home.searchindex.json -- the per-language search index.

  Rendered once per language into that language's URL tree
  (/searchindex.json, /ru/searchindex.json) because Hugo renders the home
  page's output formats per language.

  Envelope (schemaVersion 1), in the order it is emitted and for the reason
  documented at the emission site below -- metadata first, payload last:
  schemaVersion, generated (the BUILD's RFC 3339 timestamp, data-only,
  excluded from the digest), lang, digest (xxHash of the serialized docs --
  the content signal the client-side cache key requires, because this URL is
  stable rather than fingerprinted), docCount, docs.

  `generated` answers what `digest` cannot. A digest says "is this
  different"; it cannot say "which one is newer", and a client holding a
  cached index needs the direction to know whether ITS copy is the stale one.
  The value therefore comes from search/lib/build-time.html rather than from
  `now`: it is constant for the whole build, identical in every language's
  index, and identical to what the agent-readiness module stamps into its own
  surfaces when a site runs both. A per-render `now` here would split
  /searchindex.json from /ru/searchindex.json of one deploy and report drift
  that is not there.

  Inclusion filters, in order: master switch (enable = false empties the
  range but the envelope still emits so the wired URL never 404s); section
  allow-list at segment boundaries; per-page opt-out (search: false or
  search.exclude: true); the dedicated search page itself (indexing it
  would surface its own UI chrome as a result); robots noindex interplay.
  The last two are overridable per page by explicitly setting
  search.exclude: false.
*/ -}}
{{- $cfg := partial "search/config.html" (dict "page" . "site_only" true) -}}
{{- $searchPagePath := "" -}}
{{- with site.GetPage $cfg.page_path -}}{{- $searchPagePath = .Path -}}{{- end -}}
{{- $json := dict "noHTMLEscape" true -}}
{{/* Two representations of the same records, and both are load-bearing.
     $docs holds the record DICTS and feeds the digest, whose definition is
     frozen: the default-escaped jsonify of this slice, so a rebuild that
     changed no content leaves every client's cache key alone. $docsJson
     holds each record already serialized with its members in a chosen
     order, which is what actually reaches the file -- see
     search/lib/record-json.html for why a record's own member order is
     worth this much machinery. */}}
{{- $docs := slice -}}
{{- $docsJson := slice -}}
{{/* Scratch, not a dict accumulator: the sentinel needs EXACT-key
     lookups on both sides, and merge folds map keys case-insensitively,
     so a case-variant href would swallow a later true duplicate's
     sentinel along with its warning. */}}
{{- $seen := newScratch -}}
{{- if $cfg.enable -}}
  {{- range site.RegularPages -}}
    {{- $keep := true -}}

    {{/* Section scope: equality or normalized-entry-plus-slash prefix, so
         docs never matches /docs-internal/... and docs/guides never matches
         /docs/guides-old/.... */}}
    {{- if $cfg.sections -}}
      {{- $keep = false -}}
      {{- $p := .Path -}}
      {{- $section := .Section -}}
      {{- range $cfg.sections -}}
        {{- if or (eq (printf "/%s" $section) .) (eq $p .) (hasPrefix $p (printf "%s/" .)) -}}
          {{- $keep = true -}}
        {{- end -}}
      {{- end -}}
    {{- end -}}

    {{/* Per-page opt-out: bare `search: false` (or its string forms) and the
         map form search.exclude: true. Any other non-map value warns once
         and is ignored. */}}
    {{- $pagep := .Params.search -}}
    {{- $excludeSet := false -}}
    {{- $exclude := false -}}
    {{- if reflect.IsMap $pagep -}}
      {{- if isset $pagep "exclude" -}}
        {{- $excludeSet = true -}}
        {{- $exclude = in (slice "true" "1" "yes" "on") (lower (printf "%v" (index $pagep "exclude"))) -}}
      {{- end -}}
    {{- else if ne $pagep nil -}}
      {{- if in (slice "false" "0" "no" "off") (lower (printf "%v" $pagep)) -}}
        {{- $excludeSet = true -}}
        {{- $exclude = true -}}
      {{- else -}}
        {{- partial "search/lib/warn.html" (dict
            "key" (printf "search:warn:nonmap-config:%s" .RelPermalink)
            "message" (printf "[search] Ignoring the search front matter value on %s: expected a map (or the bare `search: false` opt-out shorthand), got %v." .RelPermalink $pagep)) -}}
      {{- end -}}
    {{- end -}}
    {{- if $exclude -}}{{- $keep = false -}}{{- end -}}

    {{/* The dedicated search page hosts the search UI itself; indexing it
         would surface its own rendered chrome (labels, hints, noscript
         guidance) as a result. It stays out unless the author explicitly
         sets search.exclude: false (presence wins). */}}
    {{- if and $keep $searchPagePath (eq .Path $searchPagePath) -}}
      {{- if not (and $excludeSet (not $exclude)) -}}
        {{- $keep = false -}}
      {{- end -}}
    {{- end -}}

    {{/* A page hidden from crawlers stays out of site search too, unless the
         author explicitly sets search.exclude: false (presence wins). */}}
    {{- if and $keep (in (lower (printf "%v" (.Params.robots | default ""))) "noindex") -}}
      {{- if not (and $excludeSet (not $exclude)) -}}
        {{- $keep = false -}}
      {{- end -}}
    {{- end -}}

    {{/* href is the engine's document id and duplicate ids break
         client-side search, so colliding permalinks (for example two
         pages with the same url front matter) must not reach the
         envelope: the first record wins and each collision warns once. */}}
    {{- if $keep -}}
      {{- $record := partialCached "search/lib/record.html" (dict "page" . "cfg" $cfg) .Path -}}
      {{- if $seen.Get $record.href -}}
        {{- partial "search/lib/warn.html" (dict
            "key" (printf "search:warn:duplicate-href:%s" $record.href)
            "message" (printf "[search] Skipping the duplicate search index record for %s: another page already emitted this permalink, and duplicate record ids would break client-side search." $record.href)) -}}
      {{- else -}}
        {{- $seen.Set $record.href true -}}
        {{- $docs = $docs | append $record -}}
        {{- $docsJson = $docsJson | append (partial "search/lib/record-json.html" (dict "record" $record "opts" $json)) -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
{{/* The envelope is emitted member by member, in a FIXED order, because the
     order is load-bearing and a Go map cannot carry one: jsonify serializes
     map keys alphabetically, which put `docs` third and left `generated`,
     `lang` and `schemaVersion` behind a payload that reaches hundreds of
     kilobytes on a real site. Every reader that samples this document from
     the front -- a curl piped to head, a truncated preview, a streaming
     parser, an agent working to a context budget -- then finds `digest` and
     `docCount`, finds no timestamp, and concludes there is none. That is not
     hypothetical: two independent readers reached exactly that conclusion
     three times over, and the second of them re-checked after the field was
     added and reported it still missing. The stamp exists to be cheaper than
     reading the document; behind the payload it is strictly more expensive.

     So: every field that DESCRIBES the document precedes the field that IS
     the document. JSON member order carries no semantics, so nothing that
     parses this file can notice the change, and the only readers affected
     are the ones that never reach the end.

     The SAME argument applies one level down, to a record's own members,
     which is why `docs` is joined from records that search/lib/record-json.html
     already serialized rather than handed whole to jsonify: a record is a
     map too, and alphabetical order put its indexed body ahead of its href
     and title.

     Every VALUE goes through jsonify, so escaping, quoting and number
     formatting stay the encoder's job -- the only characters written by hand
     are the braces, brackets, colons, commas and the six key names, which are
     fixed ASCII literals. The serialization suite reads these bytes against a
     corpus of quotes, ampersands, backslashes, newlines and non-ASCII for
     exactly that reason. `noHTMLEscape` is safe for a standalone .json file
     and smaller; the envelope must not be inlined into a <script> tag as-is.
     The digest's input is deliberately NOT this serialization: it stays the
     default-escaped jsonify of the docs alone, unchanged, so no cached
     client sees a digest move for a reason that is not a content change. */}}
{{- $members := slice
  (printf `"schemaVersion":%s` (jsonify $json 1))
  (printf `"generated":%s` (jsonify $json (partial "search/lib/build-time.html" .)))
  (printf `"lang":%s` (jsonify $json site.Language.Name))
  (printf `"digest":%s` (jsonify $json (hash.XxHash ($docs | jsonify))))
  (printf `"docCount":%s` (jsonify $json (len $docs)))
  (printf `"docs":[%s]` (delimit $docsJson ","))
-}}
{{- printf "{%s}" (delimit $members ",") -}}
