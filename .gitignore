# OS
Thumbs.db
.DS_Store

# Captured output. Every log this repository produces is scratch -- a build
# capture, a test runner's server log, a one-off shell redirect -- and none is
# ever committed, so the class is ignored rather than enumerated name by name:
# the name nobody anticipated is exactly the one that reaches a commit. Force
# a genuine exception with `git add -f`.
*.log

# Hugo build artifacts
public/
resources/
.hugo_build.lock

# The agent-readiness fixture ORIGIN's pid file. The runners start that server
# before the builds and stop it afterwards, and the pid file is removed on an
# interrupt; tracked here so a hard-killed run cannot leave an untracked file
# behind.
origin.pid

# Go
vendor/

# Node.js
node_modules/

# Playwright run artifacts
test-results/
playwright-report/

# Static overlay builds the search and copy-page test runners produce and
# remove; tracked here so a hard-killed run cannot leave untracked directories
# behind. Each one's captured log is covered by the *.log rule above, so a new
# overlay adds one line here rather than two. Extend this list whenever
# modules/search/test/run-tests.sh or modules/copy-page/test/run-tests.sh gains
# an overlay.
.opensearch-hostile/
.opensearch-off/
.subpath/
.scalar-tables/
.serialization/
.shape-tables/
.shape-bools/
.shape-lists/
.multilingual/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Hugo module cache
_vendor/

# Tooling
.serena/
.claude/
.context_server/
.code-review-graph/
.playwright-cli/

# Lint / format caches
.eslintcache
.prettiercache

# Mutation-testing backups. A spec is proven non-vacuous by mutating the
# template it covers and confirming the suite turns red, and the safe way to
# undo that is a file copy rather than `git checkout --`, which would discard
# uncommitted work along with the mutant. Those copies land inside the module's
# own mounted layouts/ tree, so an untracked one is a file that could ship
# inside the published module.
*.bak
