# OS
Thumbs.db
.DS_Store

# Hugo build artifacts
public/
resources/
.hugo_build.lock
hugo-build*.log

# The agent-readiness fixture ORIGIN's captured log and its pid file. The
# runners start that server before the builds and stop it afterwards, and both
# artifacts are removed on an interrupt; tracked here so a hard-killed run
# cannot leave untracked files behind.
fixture-origin.log
origin.pid

# Go
vendor/

# Node.js
node_modules/

# Playwright run artifacts
test-results/
playwright-report/

# Static overlay builds, their captured logs, and the served-fixture log the
# search and copy-page test runners produce and remove (both write
# .hugo-server.log); tracked here so a hard-killed run cannot leave untracked
# artifacts behind. Extend this list whenever modules/search/test/run-tests.sh
# or modules/copy-page/test/run-tests.sh gains an overlay.
.opensearch-hostile/
.opensearch-off/
.subpath/
.scalar-tables/
.serialization/
.shape-tables/
.shape-bools/
.shape-lists/
.multilingual/
.opensearch-hostile.log
.opensearch-off.log
.subpath.log
.scalar-tables.log
.serialization.log
.shape-tables.log
.shape-bools.log
.shape-lists.log
.multilingual.log
.hugo-server.log

# IDE
.idea/
.vscode/
*.swp
*.swo

# Hugo module cache
_vendor/

# Tooling
.serena/
.claude/
.context_server/
.code-review-graph/
.playwright-cli/

# Lint / format caches
.eslintcache
.prettiercache

# Mutation-testing backups. A spec is proven non-vacuous by mutating the
# template it covers and confirming the suite turns red, and the safe way to
# undo that is a file copy rather than `git checkout --`, which would discard
# uncommitted work along with the mutant. Those copies land inside the module's
# own mounted layouts/ tree, so an untracked one is a file that could ship
# inside the published module.
*.bak
