# OS
Thumbs.db
.DS_Store

# Captured output and process bookkeeping. Every log and pid file this
# repository produces is scratch -- a build capture, a test runner's server log
# and the pid it stops it by, a one-off shell redirect -- and none is ever
# committed, so the class is ignored rather than enumerated name by name: the
# name nobody anticipated is exactly the one that reaches a commit. Force a
# genuine exception with `git add -f`.
*.log
*.pid

# Secrets. `examples/backend-express/.env.example` instructs the reader to copy
# it to `.env` and fill in a database URL and a VAPID private key, so the file
# it tells them to create must be unstageable before they create it. The
# example itself stays tracked.
.env
.env.*
!.env.example

# Hugo build artifacts
public/
resources/
.hugo_build.lock

# Go
vendor/

# Node.js
node_modules/

# Playwright run artifacts
test-results/
playwright-report/

# Scratch build directories a module's test runner writes beside itself: the
# static overlays the search suite builds under one config each, and anything
# a future runner adds. They are removed on a clean exit and left behind by a
# hard kill, and every one of them is dot-prefixed inside a test/ directory,
# which no tracked file is.
**/test/.*/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Hugo module cache
_vendor/

# Tooling
.serena/
.claude/
.context_server/
.code-review-graph/
.playwright-cli/

# Lint / format caches
.eslintcache
.prettiercache

# Mutation-testing backups. A spec is proven non-vacuous by mutating the
# template it covers and confirming the suite turns red, and the safe way to
# undo that is a file copy rather than `git checkout --`, which would discard
# uncommitted work along with the mutant. Those copies land inside the module's
# own mounted layouts/ tree, so an untracked one is a file that could ship
# inside the published module.
*.bak
